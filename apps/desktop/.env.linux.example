# Optional Linux packaging settings. Copy to .env.linux (Git ignored); packaging runs without this file.
# Linux packages carry no code signature, update feed, or mandatory-update policy, so only these fields apply.
# Use UTF-8; values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Debian control Maintainer as "Name <address>". Omit to record the documented placeholder address.
# DSH_DESKTOP_LINUX_MAINTAINER=DeepSeek Harness <noreply@deepseek-harness.invalid>

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
